rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPreApprovedAdminEmail() {
      return isSignedIn() && 
        (request.auth.token.email == 'ihartleytutoring@gmail.com' ||
         request.auth.token.email == 'imraanhartley76@gmail.com' ||
         request.auth.token.email == 'yaaseen.abrahams@gmail.com');
    }

    function isAdmin() {
      return isPreApprovedAdminEmail() || 
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Grades (Schooling years)
    match /grades/{gradeId} {
      allow read: if true; // Public catalog for visitors to explore
      allow write: if isAdmin();
    }

    // Subjects under grades
    match /subjects/{subjectId} {
      allow read: if true; // Public catalog
      allow write: if isAdmin();
    }

    // Curriculum Topics
    match /topics/{topicId} {
      allow read: if true; // Public outline
      allow write: if isAdmin();
    }

    // Lessons (Videos, Notes, Quizzes)
    match /lessonItems/{itemId} {
      // Content items can be read by signed in users or previewed, write restricted to admin
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // Package Pricing (Grade + Subject pricing)
    match /packagePrices/{packageId} {
      allow read: if true; // Public pricing
      allow write: if isAdmin();
    }

    // Student Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // User Progress (Videos watched, notes done, quizzes passed at 100%)
    match /userProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Enquiries from contact form
    match /enquiries/{enquiryId} {
      allow create: if true; // Open to any visitor submitting inquiry
      allow read, update, delete: if isAdmin();
    }
  }
}
